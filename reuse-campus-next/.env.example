# MySQL connection (reuse the existing reuse_campus database)
DATABASE_URL="mysql://root@localhost:3306/reuse_campus"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST=true

# Google OAuth (optional; enables "Continue with Google" on login/register)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Upload storage (relative to project root)
UPLOAD_DIR="./public/uploads"

# Optional: public app URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
